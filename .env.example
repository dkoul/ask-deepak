# DeepSeek API key — server-side only, never exposed to the browser
DEEPSEEK_API_KEY=

# Google reCAPTCHA
# Site key (public) — used by the browser widget
RECAPTCHA_SITE_KEY=
# Secret key (private) — server-side verification only, never expose this
RECAPTCHA_SECRET_KEY=
# v2 = checkbox widget, v3 = invisible score-based (default: v2)
RECAPTCHA_VERSION=v2
# Minimum score for v3 (0.0–1.0, default 0.5)
RECAPTCHA_MIN_SCORE=0.5

# Optional tuning
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=300
MAX_QUESTION_LENGTH=2500
MAX_ANSWER_LENGTH=600
MAX_HISTORY_MESSAGES=6
PORT=3000
